+#[cfg(not(target_feature = "avx512f"))]
+pub fn fast_batched_dot_product_avx512<const K: usize, T: Copy + ToU64>(
+    params: &Params,
+    c: &mut [u64],
+    a: &[u64],
+    a_elems: usize,
+    b_t: &[T], // transposed
+    b_rows: usize,
+    b_cols: usize,
+) {
+    assert_eq!(a_elems, b_rows);
+    assert!(a.len() >= K * a_elems);
+    assert!(c.len() >= K * b_cols);
+
+    // Each product is below 2^32 * 2^16, so a chunk of this many terms stays
+    // below 2^64 before it is reduced.
+    const CHUNK: usize = 1 << 15;
+    let low_mask = (1u64 << 32) - 1;
+    let a_stride = a.len() / K;
+    let c_stride = c.len() / K;
