+#[cfg(not(target_feature = "avx512f"))]
+pub fn fast_batched_dot_product_avx512<const K: usize, T: Copy + ToU64>(
+    params: &Params,
+    c: &mut [u64],
+    a: &[u64],
+    a_elems: usize,
+    b_t: &[T], // transposed
+    b_rows: usize,
+    b_cols: usize,
+) {
+    assert_eq!(a_elems, b_rows);
+    assert!(a.len() >= K * a_elems);
+    assert!(c.len() >= K * b_cols);
+
+    // Each product is below 2^32 * 2^16, so a chunk of this many terms stays
+    // below 2^64 before it is reduced.
+    const CHUNK: usize = 1 << 15;
+    let low_mask = (1u64 << 32) - 1;
+    let a_stride = a.len() / K;
+    let c_stride = c.len() / K;
+
+    for j in 0..b_cols {
+        let b_col = &b_t[j * b_rows..(j + 1) * b_rows];
+        for batch in 0..K {
+            let a_slc = &a[batch * a_stride..batch * a_stride + a_elems];
+            let mut acc = c[batch * c_stride + j];
+            for (a_chunk, b_chunk) in a_slc.chunks(CHUNK).zip(b_col.chunks(CHUNK)) {
+                let mut sum_lo = 0u64;
+                let mut sum_hi = 0u64;
+                for (&a_val, &b_val) in a_chunk.iter().zip(b_chunk.iter()) {
+                    let b_val = b_val.to_u64();
+                    sum_lo += (a_val & low_mask) * b_val;
+                    sum_hi += (a_val >> 32) * b_val;
+                }
+                let lo = barrett_coeff_u64(params, sum_lo, 0);
+                let hi = barrett_coeff_u64(params, sum_hi, 1);
+                let res = params.crt_compose_2(lo, hi);
+                acc = barrett_u64(params, acc + res);
+            }
+            c[batch * c_stride + j] = acc;
+        }
+    }
+}
 
